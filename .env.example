# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API). The anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: bypasses RLS. Used by the daily cron dispatcher (scan photo cleanup, series re-sync, recommendation
# refresh) and by Discover's series sync, which writes the shared series cache. Without it, series sync says it is not
# configured and recommendations still work.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (phases 3 and 5): cover/spine photo recognition and the Discover recommendations (claude-opus-5-5,
# about 5-6 cents per refresh for a small library, more for a big one; capped at 5 refreshes per person and 5 per library per day,
# and the weekly cron refreshes only people active in the last 30 days). Server only.
# Photo recognition is capped at 50 reads per person per rolling 24 hours (see DAILY_SCAN_CAP in
# src/lib/scan/photo.ts); also set a spend limit in the Anthropic Console.
ANTHROPIC_API_KEY=

# Book metadata providers (phase 2). Server only. Both are optional: without a Hardcover
# token that provider is skipped (no series or Hardcover ratings), and Google Books works
# without a key on a small shared quota. Open Library needs no key.
# Hardcover: hardcover.app account settings > API. Paste the token as given (with or without "Bearer ").
HARDCOVER_API_TOKEN=
GOOGLE_BOOKS_API_KEY=

# eBay Browse API (phase 6): market prices for physical copies (hardcover, paperback). Server only. Use a PRODUCTION keyset
# (developer.ebay.com > Application Keys); the app asks for the public scope https://api.ebay.com/oauth/api_scope.
# Prices are asking prices of active fixed-price listings on the library's marketplace (set per library in Settings > Prices).
# On-demand "Check price" is capped at 30 per person per rolling 24 hours (src/lib/pricing/limits.ts). The daily cron price refresh
# makes at most 300 search calls per run (src/lib/pricing/refresh.ts), well under eBay's default Browse allowance of
# thousands of calls a day. Without these two values no price check runs and the cron task is skipped.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Sign in with Apple. The "Continue with Apple" button is hidden unless this is exactly "true". Turn it on only once the Apple
# provider is configured in Supabase (it needs a paid Apple Developer account). Read at build time, so redeploy after changing it.
# Google sign-in needs no flag.
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=

# Full access (who may use Claude, eBay, Hardcover and Google Books) is granted per account on the /admin page, not by an
# environment variable. See README > Access control.

# Shared secret that Vercel Cron sends as "Authorization: Bearer <value>". Protects /api/cron/*: the single daily
# dispatcher (GET /api/cron/daily, scheduled in vercel.json) and the manual scan cleanup (/api/cron/scan-cleanup).
# The dispatcher skips a task whose own variable is missing (HARDCOVER_API_TOKEN for the series re-sync,
# EBAY_CLIENT_ID and EBAY_CLIENT_SECRET for the price refresh, ANTHROPIC_API_KEY for the recommendation refresh) and needs SUPABASE_SERVICE_ROLE_KEY for everything.
CRON_SECRET=
